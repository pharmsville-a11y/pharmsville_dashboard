# 로컬에서 수집을 돌릴 때만 씁니다. 이 파일을 복사해 .env.local 로 저장하세요.
# .env.local 은 git에 올라가지 않습니다. 값을 채팅에 붙여 넣지 마세요.

COLLECT_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/collect-daily
COLLECT_SECRET=

# 대시보드는 광고 조회 Function 을 읽습니다. GitHub Pages 빌드는 URL만 넣습니다.
# 로컬에서 시크릿을 쓰려면 VITE_QUERY_SECRET 을 채우면 됩니다.
VITE_QUERY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/query-ads
VITE_QUERY_SECRET=
