# 로컬에서 수집을 돌릴 때만 씁니다. 이 파일을 복사해 .env.local 로 저장하세요.
# .env.local 은 git에 올라가지 않습니다. 값을 채팅에 붙여 넣지 마세요.

COLLECT_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/collect-daily
COLLECT_SECRET=

# 로컬 npm run dev 가 EC2 collect API 를 프록시할 때 씁니다.
# EC2 /opt/channelboard/.env 의 COLLECT_SECRET 과 동일한 값을 넣으세요.
# (VITE_ 접두사 없음 → 브라우저 번들에 포함되지 않음)

# 대시보드는 광고 조회 Function 을 읽습니다. GitHub Pages 빌드는 URL만 넣습니다.
# 로컬에서 시크릿을 쓰려면 VITE_QUERY_SECRET 을 채우면 됩니다.
VITE_QUERY_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/query-ads
VITE_QUERY_SECRET=

# 비우면 VITE_QUERY_URL 의 query-ads 를 query-pluscl 로 바꿔 씁니다.
VITE_PLUSCL_URL=

# 비우면 VITE_QUERY_URL 의 query-ads 를 query-snapshots 로 바꿔 매출을 읽습니다.
VITE_SNAPSHOTS_URL=

# 개인 실험실: npm run dev 로 로컬 실행 시에만 사이드바에 표시됩니다.
# 프로덕션 빌드(vite build)에는 절대 포함되지 않습니다.
